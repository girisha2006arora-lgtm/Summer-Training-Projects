    "import numpy as np\n",
    "from PIL import Image\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "img=Image.open(r\"C:\\Users\\HP\\Downloads\\Butterfly.jpeg\")\n",
    "\n",
    "img=np.array(img)\n",
    "img[:, :,0]=np.clip(img[:,:,0]+90, 100, 255)\n",
    "\n",
    "plt.imshow(img)\n",
    "plt.axis(\"off\")\n",
    "plt.show()"
   ]
